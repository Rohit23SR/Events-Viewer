# Events Viewer Environment Configuration
# Copy this file to .env.local for local development

# API Configuration (self-hosted data in public/data/)
VITE_API_URL=/data/event-data.json

# CORS Proxy (only needed if pointing to an external API)
VITE_CORS_PROXY_URL=

# Feature Flags
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_SEARCH=true
VITE_ENABLE_SORTING=true
